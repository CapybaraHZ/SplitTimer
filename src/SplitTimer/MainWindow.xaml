<Window x:Class="SplitTimer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:SplitTimer.Models"
        Title="读秒计时器"
        Width="1280" Height="820"
        MinWidth="980" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBaseBrush}"
        FontFamily="{StaticResource UiFont}"
        InputMethod.IsInputMethodEnabled="False"
        InputMethod.PreferredImeState="Off"
        InputMethod.PreferredImeConversionMode="NoConversion"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp"
        Activated="Window_Activated"
        Deactivated="Window_Deactivated">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0.55,1">
                <GradientStop Color="#0C1119" Offset="0" />
                <GradientStop Color="#070A0F" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Margin="24,18,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============ 顶部 ============ -->
            <Grid Grid.Row="0" Margin="4,0,4,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="11"
                            Background="#102B36" BorderBrush="#1D6B80" BorderThickness="1">
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="24" Height="24">
                                <Ellipse Canvas.Left="3" Canvas.Top="6" Width="18" Height="16"
                                         Stroke="{StaticResource AccentBrush}" StrokeThickness="1.7" />
                                <Line X1="12" Y1="6" X2="12" Y2="2.5"
                                      Stroke="{StaticResource AccentBrush}" StrokeThickness="1.7" />
                                <Line X1="9" Y1="2.5" X2="15" Y2="2.5"
                                      Stroke="{StaticResource AccentBrush}" StrokeThickness="1.7" />
                                <Line X1="12" Y1="14" X2="12" Y2="9.5"
                                      Stroke="{StaticResource AccentBrush}" StrokeThickness="1.7" />
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="读秒计时器"
                                   FontSize="17.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock x:Name="SubtitleText"
                                   Text="多人同场 · 毫秒级精度"
                                   FontSize="11.5" Margin="0,2,0,0"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border x:Name="StatusPill" CornerRadius="10" Padding="13,6" Margin="0,0,10,0"
                            Background="#141B26" BorderBrush="#26303F" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#5B6579"
                                     Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusPillText" Text="就绪" FontSize="12.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnFullScreen" Style="{StaticResource GhostButton}"
                            Padding="14,7" FontSize="12.5" Margin="0,0,8,0"
                            AutomationProperties.Name="全屏"
                            Click="BtnFullScreen_Click" ToolTip="全屏显示（F11）">
                        <TextBlock Text="全屏" />
                    </Button>

                    <Button x:Name="BtnExitFullScreen" Style="{StaticResource GhostButton}"
                            Padding="14,7" FontSize="12.5" Margin="0,0,8,0"
                            Visibility="Collapsed"
                            AutomationProperties.Name="退出全屏"
                            Click="BtnExitFullScreen_Click" ToolTip="退出全屏（F11 或 Esc）">
                        <TextBlock Text="退出全屏" />
                    </Button>

                    <Button x:Name="BtnSettings" Style="{StaticResource GhostButton}"
                            Padding="16,7" FontSize="12.5"
                            AutomationProperties.Name="设置"
                            Click="BtnSettings_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="设置" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============ 玩家卡片区 ============ -->
            <Grid Grid.Row="1">
                <ItemsControl x:Name="PlayerItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding CardColumns, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:Player}">
                            <Border x:Name="Card" Margin="7" Padding="20,15" CornerRadius="18" BorderThickness="1.5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding VisualState}" Value="running">
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                <Setter Property="Background" Value="#0F1E28" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding VisualState}" Value="done">
                                                <Setter Property="BorderBrush" Value="#2B6F55" />
                                                <Setter Property="Background" Value="#0E1B18" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding VisualState}" Value="hidden">
                                                <Setter Property="BorderBrush" Value="#2A3444" />
                                                <Setter Property="Background" Value="#101620" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- 名字 + 名次 -->
                                    <Grid Grid.Row="0">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="14.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="260" HorizontalAlignment="Left"
                                                   VerticalAlignment="Center" />
                                        <Border HorizontalAlignment="Right" CornerRadius="7"
                                                Background="#2A2211" BorderBrush="#5C4A18"
                                                BorderThickness="1" Padding="9,2"
                                                Visibility="{Binding HasRank, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding RankText}" FontSize="11.5"
                                                       Foreground="{StaticResource GoldBrush}" />
                                        </Border>
                                    </Grid>

                                    <!-- 读数 -->
                                    <Grid Grid.Row="1" Margin="0,4">
                                        <Viewbox x:Name="TimeBox" Stretch="Uniform" Margin="2,6" MaxHeight="220">
                                            <TextBlock Text="{Binding TimeText}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="100" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding VisualState}" Value="running">
                                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding VisualState}" Value="done">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding VisualState}" Value="hidden">
                                                                <Setter Property="Foreground" Value="#3B4759" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Viewbox>

                                    </Grid>

                                    <!-- 状态 + 按键 -->
                                    <Grid Grid.Row="2">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Margin="0,0,8,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#3C4759" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding VisualState}" Value="running">
                                                                <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                                <DataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="PulseStory">
                                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True"
                                                                                    FillBehavior="Stop">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                             From="1" To="0.28"
                                                                                             Duration="0:0:0.7" />
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.EnterActions>
                                                                <DataTrigger.ExitActions>
                                                                    <StopStoryboard BeginStoryboardName="PulseStory" />
                                                                </DataTrigger.ExitActions>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding VisualState}" Value="done">
                                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding VisualState}" Value="hidden">
                                                                <Setter Property="Fill" Value="#6A7488" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>

                                            <TextBlock Text="{Binding StatusText}" FontSize="12"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding VisualState}" Value="running">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding VisualState}" Value="done">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding VisualState}" Value="hidden">
                                                                <Setter Property="Foreground" Value="#3B4759" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <Border HorizontalAlignment="Right" CornerRadius="6"
                                                Background="#18202C" BorderBrush="#242E3E"
                                                BorderThickness="1" Padding="10,3">
                                            <TextBlock Text="{Binding KeyText}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="11.5"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 倒计时遮罩 -->
                <Border x:Name="CountdownOverlay" Visibility="Collapsed" CornerRadius="18"
                        Background="#F0090D14">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="准备开始" FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="CountdownText" Text="3"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="150" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" Margin="0,2,0,0" />
                        <TextBlock Text="各玩家就位，倒计时结束后开始读秒"
                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ 排名条（按时间周期统计） ============ -->
            <Border Grid.Row="2" CornerRadius="13" Padding="14,0" Height="50" Margin="4,13,4,0"
                    Background="#101722" BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="排名" FontSize="12" Margin="0,0,9,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="RankPeriodText" Text="自动排名已关闭"
                                   FontSize="11.5" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>

                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled" Margin="16,0,10,0"
                                  VerticalAlignment="Center">
                        <StackPanel>
                            <ItemsControl x:Name="RankItems">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:RankEntry}">
                                        <Border CornerRadius="9" Padding="9,4" Margin="0,0,8,0"
                                                BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#151E2A" />
                                                    <Setter Property="BorderBrush" Value="#232E3D" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLeader}" Value="True">
                                                            <Setter Property="Background" Value="#221C0D" />
                                                            <Setter Property="BorderBrush" Value="#5C4A18" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="19" Height="19" CornerRadius="6"
                                                        Background="#26313F" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#26313F" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLeader}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource GoldBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding RankText}"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               FontSize="10.5" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsLeader}" Value="True">
                                                                        <Setter Property="Foreground" Value="#231A05" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <TextBlock Text="{Binding Name}" FontSize="11.5"
                                                           Margin="7,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />

                                                <TextBlock Text="{Binding TimeText}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="11.5" Margin="8,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource AccentBrush}" />

                                                <TextBlock Text="{Binding RunsText}" FontSize="10"
                                                           Margin="6,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           Visibility="{Binding HasRuns, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <TextBlock x:Name="RankEmptyText" Grid.Column="1"
                               Text="在「设置」里填写统计周期（分钟）即可开启自动排名"
                               FontSize="11.5" Margin="16,0,10,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextMutedBrush}" />

                    <Button x:Name="BtnClearRank" Grid.Column="2" Style="{StaticResource SmallGhostButton}"
                            Padding="11,4" FontSize="11.5" AutomationProperties.Name="清空"
                            Click="BtnClearRank_Click"
                            VerticalAlignment="Center" ToolTip="清空当前周期内的历史成绩">
                        <TextBlock Text="清空" />
                    </Button>
                </Grid>
            </Border>

            <!-- ============ 底部控制 ============ -->
            <Grid Grid.Row="3" Margin="4,13,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="13" Padding="16,9"
                        Background="#101722" BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="本轮总时" FontSize="12" Margin="0,0,11,0"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="TotalTimeText" Text="00:00.000"
                                   FontFamily="{StaticResource MonoFont}" FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="HintText" Grid.Column="1"
                           Text="按 空格 开始 · 每位玩家按下自己的按键停表"
                           FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="14,0" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnReset" Style="{StaticResource GhostButton}"
                            Padding="20,11" Margin="0,0,10,0"
                            AutomationProperties.Name="重置" Click="BtnReset_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="重置" VerticalAlignment="Center" />
                            <Border CornerRadius="6" Background="#18202C" BorderBrush="#2B3648"
                                    BorderThickness="1" Padding="7,1" Margin="9,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="ResetKeyText" Text="Esc"
                                           FontFamily="{StaticResource MonoFont}" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnReveal" Style="{StaticResource GoldButton}"
                            Margin="0,0,10,0" Visibility="Collapsed"
                            AutomationProperties.Name="显示结果" Click="BtnReveal_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="显示结果" VerticalAlignment="Center" />
                            <Border CornerRadius="6" Background="#26000000" Padding="7,1"
                                    Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="RevealKeyText" Text="回车"
                                           FontFamily="{StaticResource MonoFont}" FontSize="11"
                                           Foreground="#04161E" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnStart" Style="{StaticResource PrimaryButton}"
                            AutomationProperties.Name="开始" Click="BtnStart_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="开始" VerticalAlignment="Center" />
                            <Border CornerRadius="6" Background="#26000000" Padding="7,1"
                                    Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="StartKeyText" Text="空格"
                                           FontFamily="{StaticResource MonoFont}" FontSize="11"
                                           Foreground="#04161E" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
