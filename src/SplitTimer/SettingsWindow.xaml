<Window x:Class="SplitTimer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="600" Height="800"
        MinWidth="560" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBaseBrush}"
        FontFamily="{StaticResource UiFont}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="4,0,0,18">
            <TextBlock Text="设置" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="读数显示规则与各玩家的按键都可以在这里调整"
                       FontSize="12" Margin="0,4,0,0"
                       Foreground="{StaticResource TextMutedBrush}" />
        </StackPanel>

        <!-- 通用选项 -->
        <Border Grid.Row="1" CornerRadius="14" Padding="16,14" Margin="0,0,0,14"
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="停表后自动隐藏读数" FontSize="13.5"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="玩家按停后自己的读数变为隐藏，全部完成后用「显示结果」统一揭示"
                                   FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" MaxWidth="380"
                                   HorizontalAlignment="Left"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                    <CheckBox x:Name="ChkAutoHide" Style="{StaticResource ToggleSwitch}"
                              AutomationProperties.Name="停表后自动隐藏读数"
                              HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="开始前 3 秒准备倒计时" FontSize="13.5"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="避免还没就位就开始读秒；关闭后点「开始」立即计时"
                                   FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" MaxWidth="380"
                                   HorizontalAlignment="Left"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                    <CheckBox x:Name="ChkCountdown" Style="{StaticResource ToggleSwitch}"
                              AutomationProperties.Name="开始前准备倒计时"
                              HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <Grid Margin="0,16,0,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="自动排名统计周期" FontSize="13.5"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="按最近 N 分钟内每位玩家的最好成绩排名；填 0 关闭自动排名"
                                   FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" MaxWidth="360"
                                   HorizontalAlignment="Left"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBox x:Name="TxtRankWindow" Style="{StaticResource DarkTextBox}"
                                 AutomationProperties.Name="自动排名统计周期"
                                 Width="66" MaxLength="4" TextAlignment="Center"
                                 FontFamily="{StaticResource MonoFont}" />
                        <TextBlock Text="分钟" FontSize="12" Margin="7,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 玩家数量 -->
        <Grid Grid.Row="2" Margin="4,0,4,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="参与本轮人数" FontSize="13.5"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="PlayerCountText" Text="4" FontSize="15" FontWeight="SemiBold"
                           Margin="12,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnMinus" Style="{StaticResource SmallGhostButton}"
                        Padding="14,4" FontSize="15" Click="BtnMinus_Click" Content="−" />
                <Button x:Name="BtnPlus" Style="{StaticResource SmallGhostButton}"
                        Padding="14,4" FontSize="15" Margin="8,0,0,0" Click="BtnPlus_Click" Content="+" />
            </StackPanel>
        </Grid>

        <!-- 玩家列表 -->
        <Border Grid.Row="3" CornerRadius="14" Padding="10,12,6,4"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                <ItemsControl x:Name="RowList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="RowCard" CornerRadius="10" Padding="12,6" Margin="0,0,0,7">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#131B27" />
                                        <Setter Property="BorderBrush" Value="#25303F" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                <Setter Property="Opacity" Value="0.35" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                <Setter Property="Background" Value="#10202A" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="132" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding IndexLabel}"
                                               FontFamily="{StaticResource MonoFont}" FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" />

                                    <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DarkTextBox}" IsEnabled="{Binding IsActive}"
                                             Margin="0,0,12,0" MaxLength="16" />

                                    <Button Grid.Column="2" Style="{StaticResource SmallGhostButton}"
                                            IsEnabled="{Binding IsActive}"
                                            Click="CaptureButton_Click" Tag="{Binding}"
                                            HorizontalContentAlignment="Center">
                                        <TextBlock Text="{Binding KeyText}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="12" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 底部 -->
        <Grid Grid.Row="4" Margin="4,16,4,0">
            <TextBlock x:Name="CaptureHint" Text="点击右侧按键框可重新绑定"
                       FontSize="11.5" VerticalAlignment="Center"
                       Foreground="{StaticResource TextMutedBrush}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource GhostButton}" Padding="16,9" FontSize="12.5"
                        Margin="0,0,10,0" Click="BtnDefault_Click">
                    <TextBlock Text="恢复默认" />
                </Button>
                <Button Style="{StaticResource GhostButton}" Padding="20,9" FontSize="12.5"
                        Margin="0,0,10,0" Click="BtnCancel_Click">
                    <TextBlock Text="取消" />
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Padding="26,10" FontSize="13"
                        Click="BtnSave_Click">
                    <TextBlock Text="保存" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
